# DSN PostgreSQL (роль gateway / БД gateway в docker-compose)
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
# Путь к YAML с ресурсами и схемой (см. комментарии в файле)
CONFIG_PATH=config/config.yaml
# Оверлей технических учётных записей (ТУЗ): accounts + grants по DN сертификата
ACCOUNTS_CONFIG_PATH=config/accounts.example.yaml
# Хост bind uvicorn
HOST=0.0.0.0
# Порт HTTP API
PORT=8000
# Уровень логов: debug | info | warning | error
LOG_LEVEL=info
# Интервал опроса файла accounts на изменения (сек) для hot reload
RELOAD_INTERVAL=2.0
