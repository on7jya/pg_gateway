# DSN PostgreSQL (роль gateway / БД gateway в docker-compose)
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
# Путь к YAML с ресурсами и ACL (см. комментарии в файле)
CONFIG_PATH=config/config.yaml
# Хост bind uvicorn
HOST=0.0.0.0
# Порт HTTP API
PORT=8000
# Уровень логов: debug | info | warning | error
LOG_LEVEL=info
# Shared-secret для authz.mode=header_stub; клиент шлёт то же в X-Gateway-Token (authz.trust_header)
GATEWAY_TRUST_TOKEN=demo-trust-token
